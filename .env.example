# ================================================================
# Este archivo es una plantilla como ejemplo para las va3raibles
# de entorno (SETTINGS) que necesita el sistema
# para funcionar correctamente renombralo a .env y rellena 
# los valores según tu entorno local.
# ----------------------------------------------------------------

# ================================================================
# Plantilla de variables de entorno — este archivo SÍ se sube al
# repositorio. Contiene las claves necesarias pero SIN valores reales.
#
# Para configurar el proyecto:
#   cp .env.example .env
# y rellena los valores según tu entorno local o de producción.
# ================================================================

# Base de datos
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=crud_usuarios
DB_USERNAME=root
DB_PASSWORD=your_password_here
DB_CHARSET=utf8mb4


# ----------------------------------------------------------------
# Correo electrónico (SMTP)
# Para Gmail: activa la verificación en 2 pasos y genera una
# "Contraseña de aplicación" en Cuenta Google → Seguridad.
# Para pruebas locales puedes usar Mailtrap (sandbox.smtp.mailtrap.io).
# Coloca los valores segun tu proveedor de correo.
# ----------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=email_que_envia@proveedor.com
SMTP_PASSWORD="xxxx xxxx xxxx xxxx"
SMTP_FROM_ADDRESS=email_que_envia@proveedor.com
SMTP_FROM_NAME=Nombre que tendrá el correo que se envíe